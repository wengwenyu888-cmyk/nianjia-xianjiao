{
  "description": "念家鲜饺供应链小程序（门店端 + 司机端，分包）",
  "appid": "touristappid",
  "projectname": "nianjia-xianjiao",
  "compileType": "miniprogram",
  "miniprogramRoot": "./",
  "libVersion": "3.5.0",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "showShadowRootInWxmlPanel": true,
    "ignoreDevUnusedFiles": false
  },
  "condition": {
    "miniprogram": {
      "list": [
        { "name": "门店端-要货首页", "pathName": "store/pages/index/index", "query": "", "scene": null },
        { "name": "门店端-要货单列表", "pathName": "store/pages/order/order", "query": "", "scene": null },
        { "name": "司机端-配送任务", "pathName": "driver/pages/tasks/tasks", "query": "", "scene": null }
      ]
    }
  }
}
