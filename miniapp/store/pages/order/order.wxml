<view class="page">
  <view class="card" wx:if="{{orders.length === 0}}">
    <view class="empty">暂无可展示的要货单</view>
    <button class="btn-primary" bindtap="goCreate">新建要货单</button>
  </view>

  <view class="card" wx:for="{{orders}}" wx:key="id">
    <view class="row-between">
      <text class="order-no">{{item.order_no}}</text>
      <text class="brand-text">{{item.statusText}}</text>
    </view>
    <view class="muted">{{item.created_at}}</view>
  </view>
</view>
