/* 全局样式：三端共用的基础排版与配色 */
page {
  background-color: #f5f7fa;
  color: #303133;
  font-size: 28rpx;
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 品牌主色：念家鲜饺红 */
.brand-text {
  color: #c62828;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background-color: #c62828 !important;
  color: #ffffff !important;
}

.muted {
  color: #909399;
  font-size: 24rpx;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.empty {
  text-align: center;
  color: #909399;
  padding: 80rpx 0;
  font-size: 26rpx;
}
