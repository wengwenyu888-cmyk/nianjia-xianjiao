# ============================================================================
# 念家鲜饺供应链系统 —— 生产部署变量模板（deploy/.env.example）
# 用法：cp deploy/.env.example deploy/.env 后逐项替换 <...> 占位符
# 安全：deploy/.env 已被 .gitignore 忽略，禁止提交；
#       本文件只放占位符，禁止写入任何真实密码/密钥/token
# ============================================================================

# ---------- MySQL ----------
# root 口令：仅容器内部与备份脚本使用；生成：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=<CHANGE_ME_root_password>
# 业务库名；compose 用它初始化库，同时作为后端 DB_NAME
MYSQL_DATABASE=nianjia_xianjiao

# ---------- 后端数据库连接 ----------
# 生产固定为 compose 服务名 mysql（走内部网络，不经过宿主端口）
DB_HOST=mysql
DB_PORT=3306
# 应用专用账号（非 root，最小权限）；由 mysql 容器首次初始化时自动创建
DB_USER=nianjia
DB_PASSWORD=<CHANGE_ME_app_db_password>

# ---------- 后端应用 ----------
# 生产必须为 prod：会关闭 /docs、/redoc 与 openapi.json
ENV=prod
DEBUG=false
LOG_LEVEL=INFO
# HS256 密钥，至少 32 字节；生成：openssl rand -hex 32
JWT_SECRET_KEY=<CHANGE_ME_32bytes_plus_random_hex>
# CORS 白名单：逗号分隔，只填真实访问域名；禁止写 *
CORS_ORIGINS=https://<your-domain>

# ---------- 前端构建期变量 ----------
# 浏览器侧调用路径；nginx 已把 /api 反代到 backend，保持 /api/v1 即可
# 说明：该变量在 frontend-web/ 构建时写入 .env.production，不由 compose 注入运行时
VITE_API_BASE_URL=/api/v1

# ---------- 域名与运维 ----------
# 域名占位；未备案/未解析时可直接用服务器公网 IP 访问 80 端口
DOMAIN=<your-domain.com>
# 系统时区：MySQL、后端、备份脚本共用
TZ=Asia/Shanghai
# 备份目录与本地保留天数（deploy/backup.sh 读取，也可用环境变量覆盖）
BACKUP_DIR=/var/backups/mysql
RETENTION_DAYS=7
# 备份失败告警 webhook（可选，留空则只写 /var/log/mysql-backup.log）
ALERT_WEBHOOK=
