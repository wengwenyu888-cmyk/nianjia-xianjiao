# 部署环境变量模板：复制为 deploy/.env（已在 .gitignore 中，禁止入库）
# docker compose 会自动读取同目录的 .env

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=<root 密码>
DB_NAME=nianjia_xianjiao
DB_USER=nianjia
DB_PASSWORD=<应用库密码>

# ---------- 后端 ----------
ENV=dev
LOG_LEVEL=INFO
# 至少 32 字节随机串：openssl rand -hex 32
JWT_SECRET_KEY=<32 字节以上随机串>
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
