# ============================================================================
# MySQL 8.4 低内存调优（目标：2 vCPU / 1.3GB 内存 / 无 swap 起步的单机）
# 挂载位置：/etc/mysql/conf.d/custom.cnf（官方镜像的 my.cnf 会 include 该目录）
# 修改后生效：docker compose -f deploy/docker-compose.prod.yml restart mysql
# ============================================================================
[mysqld]
# InnoDB 缓冲池是 MySQL 内存大头；128M 覆盖小数据量热页，约为整机内存的 10%
innodb_buffer_pool_size = 128M
# redo log 写缓冲，按事务大小分配；16M 对本数据规模足够，避免挤占缓冲池
innodb_log_buffer_size = 16M
# MySQL 8.0.30+ 用总容量替代旧的 innodb_log_file_size；64M 降低磁盘与内存占用
innodb_redo_log_capacity = 64M
# 连接数上限；后端连接池默认 5+10，100 已远超实际并发，同时限制会话缓冲总量
max_connections = 100
# 关闭 performance_schema：省下 100~200MB 内存；代价是没有细粒度性能视图，本规模不需要
performance_schema = OFF
# 关闭反向 DNS 解析：连接建立更快，也避免容器 IP 无 PTR 记录导致的握手延迟
skip-name-resolve
# 字符集统一 utf8mb4：门店名/商品名含 emoji 或生僻字也能正常写入
character-set-server = utf8mb4
# 8.0 默认排序规则；显式固定避免迁移到不同默认值的实例后排序/唯一性行为漂移
collation-server = utf8mb4_0900_ai_ci
# 时区固定为北京时间，保证 NOW()/对账日切与业务口径一致（与容器 TZ 相同）
default-time-zone = '+08:00'
# 表缓存上限；小库表数量有限，200 足够，多余句柄只会白占内存与文件描述符
table_open_cache = 200
# 临时表尽量在内存完成；超过阈值落盘，上限压小以防单个查询吃光内存
tmp_table_size = 16M
max_heap_table_size = 16M
# 直接 I/O 绕过 OS page cache，避免 InnoDB 缓冲池与系统缓存双重占用同一份数据
innodb_flush_method = O_DIRECT
# 每连接排序/连接缓冲：本条为会话级上限（默认已较小），显式写出便于容量评估
sort_buffer_size = 512K
read_buffer_size = 256K
