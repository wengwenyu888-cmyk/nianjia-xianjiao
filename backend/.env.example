# 后端环境变量模板：复制为 backend/.env 后填值（.env 已在 .gitignore 中，禁止入库）
# ---------- 应用 ----------
APP_NAME=念家鲜饺供应链系统
ENV=dev
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ---------- 数据库（本地用 deploy/docker-compose.yml 起的 MySQL）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nianjia
DB_PASSWORD=<数据库密码，本地随意；线上由密钥管理注入>
DB_NAME=nianjia_xianjiao
DB_CHARSET=utf8mb4
DB_ECHO=false
# 需要直接给完整连接串时（CI/特殊场景）取消注释覆盖上面的分项配置
# DATABASE_URL=mysql+pymysql://nianjia:password@127.0.0.1:3306/nianjia_xianjiao?charset=utf8mb4

# ---------- JWT（密钥至少 32 字节随机串：openssl rand -hex 32）----------
JWT_SECRET_KEY=<替换为 32 字节以上随机串，绝不入库>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ---------- CORS：逗号分隔，禁止写 * ----------
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------- 限流 ----------
RATE_LIMIT_DEFAULT=120/minute

# ---------- 外部集成（二期启用，凭据不进代码）----------
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
