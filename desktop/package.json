{
  "name": "nianjia-xianjiao-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "念家鲜饺供应链系统 - Windows 桌面壳（Electron 包装 frontend-web 同一份网页）",
  "author": "念家鲜饺",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "dev": "electron . --dev",
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.nianjia.xianjiao.desktop",
    "productName": "念家鲜饺",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [
      { "from": "../frontend-web/dist", "to": "frontend-web", "filter": ["**/*"] }
    ],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "念家鲜饺"
    }
  }
}
